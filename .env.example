# Keep this file on the server. Never use VITE_ prefixes for secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Messaging Service with the sender attached and its registered A2P campaign:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_A2P_CAMPAIGN_SID=
# Only this farmer number receives outbound plans; use +countrycode format.
FARMER_PHONE_NUMBER=
# HTTPS origin of the hosted app or a tunnel to localhost:4173 (no path).
PUBLIC_BASE_URL=
# Allows live sending only when Twilio reports the campaign VERIFIED.
# The app checks review status every minute while open and again before each send.
# Every live text still needs a click and recipient consent.
SMS_ENABLED=false
# Required for hosted or tunnel access; minimum 32 random characters.
HARVEST_ADMIN_TOKEN=
# Optional AI extraction. Without BOTH values, local review remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Hosted Vercel deployment only. Keep these credentials server-side.
KV_REST_API_URL=
KV_REST_API_TOKEN=
